# ===== MOFU社区 环境配置 =====
# 复制为 .env 后按需修改。生产环境请务必设置随机 APP_KEY 与强数据库密码。
# 提示：全新服务器部署可直接访问 /install，由 Web 安装向导自动生成本文件（无需手动复制）。

APP_NAME="MOFU社区"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# 必填：64 位随机十六进制，用于验证码等敏感数据。
# 生成命令：php -r "echo bin2hex(random_bytes(32));"
# 通过 /install 向导安装时会自动生成。
APP_KEY=

# --- 数据库（MySQL / MariaDB）---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mofu
DB_USERNAME=mofu
DB_PASSWORD=

# --- 会话 ---
SESSION_COOKIE=mofu_session
# 会话有效期（秒），默认 30 天
SESSION_LIFETIME=2592000

# --- 前端构建 ---
# 开发时填 Vite dev server 地址（如 http://127.0.0.1:5173）以获得 HMR；留空则读取构建产物 manifest
VITE_DEV_SERVER=

# --- 上传 ---
UPLOAD_MAX_MB=8
# 视频上传上限（MB）；部署环境需同步调整 php.ini 的 upload_max_filesize / post_max_size
UPLOAD_VIDEO_MAX_MB=60

# --- 品牌默认主题色（HEX，苹果系统蓝；用户可在主题中心覆盖）---
THEME_DEFAULT_COLOR=#FFCC38

# --- 音乐播放器（独立应用，部署在 Cloudflare Pages）---
# 填了就会在 /music 内嵌播放器；留空则显示占位说明。代码在 music-app/，部署见该目录 README
MUSIC_APP_URL=

# Twikoo 评论系统（留空 TWIKOO_ENV_ID 则只用站内评论）
TWIKOO_ENV_ID=
# 评论脚本地址：默认用站内自托管副本（public/vendor/twikoo.all.min.js），可改为自建 CDN
TWIKOO_SCRIPT_URL=/vendor/twikoo.all.min.js
# 评论语言：zh-CN 已内嵌在主包里（不产生额外请求）
TWIKOO_LANG=zh-CN
# 表情包（OwO JSON）：默认站内自带的 Apple 表情包，前端通过覆写 GET_CONFIG 生效
TWIKOO_EMOTION_CDN=/vendor/emoji-apple.json

# 邮件（注册验证码 / 重置密码）：默认 log = 写入 storage/logs/mail.log，仅本地调试
# 生产请改为 smtp 并填写下面几项
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=465
# 加密：ssl（465 直连）| tls（587 STARTTLS）| 留空（25 明文）
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=
MAIL_PASSWORD=
# 发件人地址（留空时用 no-reply@<当前域名>）
MAIL_FROM=
# 应用密钥：用于邮箱验证码哈希等；安装向导会自动生成；留空时退化为由数据库口令派生（仅服务端可见）
APP_KEY=

# 易支付（V1，MD5 签名）：接口地址 / 商户 ID / 商户密钥
EZFP_API=https://www.ezfp.cn/
EZFP_PID=
EZFP_KEY=

