{#
  设置子页的常驻导航：总览 + 各分组。
  桌面端为左栏，窄屏为可横向滚动的分段导航；返回入口保留在顶部。
#}
<div class="settings-top">
    <a class="page-back" href="/settings">
        <span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>
        <span>设置</span>
    </a>
    <nav class="settings-nav" aria-label="设置导航">
        {% set settingsItems = [
            { url: '/settings', icon: 'grid_view', label: '总览' },
            { url: '/settings/profile', icon: 'badge', label: '个人资料' },
            { url: '/settings/security', icon: 'lock', label: '账号与安全' },
            { url: '/settings/notifications', icon: 'notifications', label: '通知' },
            { url: '/settings/privacy', icon: 'visibility', label: '隐私' },
            { url: '/settings/appearance', icon: 'palette', label: '外观' },
            { url: '/settings/decorations', icon: 'face_retouching_natural', label: '头像与挂件' },
            { url: '/settings/background', icon: 'wallpaper', label: '背景' }
        ] %}
        {% for item in settingsItems %}
        <a class="settings-nav__item{{ currentPath == item.url ? ' is-active' : '' }}" href="{{ item.url }}"
           {% if currentPath == item.url %}aria-current="page"{% endif %}>
            <span class="material-symbols-outlined" aria-hidden="true">{{ item.icon }}</span>
            <span>{{ item.label }}</span>
        </a>
        {% endfor %}
    </nav>
</div>
