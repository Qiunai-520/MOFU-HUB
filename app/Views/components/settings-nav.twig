{#
  设置页二级导航（5 个设置页共用；当前项由 currentPath 判定，服务端输出 aria-current）
#}
{% set settingsNav = [
    { path: '/settings/profile', label: '个人资料', key: 'settings.nav.profile' },
    { path: '/settings/security', label: '账号与安全', key: 'settings.nav.security' },
    { path: '/settings/notifications', label: '通知设置', key: 'settings.nav.notifications' },
    { path: '/settings/privacy', label: '隐私设置', key: 'settings.nav.privacy' },
    { path: '/settings/appearance', label: '个性化主题', key: 'settings.nav.appearance' },
    { path: '/settings/background', label: '背景设置', key: 'settings.nav.background' }
] %}
{# data-swup-persist：切页时保留本导航，滑块动画才能连续（6 个设置页导航项一致） #}
<nav class="settings-nav" aria-label="设置导航" data-swup-persist="settings-nav">
    {% for item in settingsNav %}
    {% set active = currentPath == item.path %}
    <a class="settings-nav__item{{ active ? ' is-active' : '' }}" href="{{ item.path }}"
       data-nav-item="{{ item.path }}" data-i18n="{{ item.key }}"{% if active %} aria-current="page"{% endif %}>{{ item.label }}</a>
    {% endfor %}
</nav>
