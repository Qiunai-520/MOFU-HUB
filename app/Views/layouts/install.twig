{#
  安装向导独立外壳：不依赖前端构建产物与数据库，样式全部内联。
#}
<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>{{ title }} · MOFU社区 安装向导</title>
<style>
    :root {
        color-scheme: light dark;
        --bg: light-dark(#F5F5F7, #000000);
        --card: light-dark(#FFFFFF, #1C1C1E);
        --ink: light-dark(#1D1D1F, #F5F5F7);
        --mut: light-dark(#6E6E73, #AEAEB2);
        --line: light-dark(#D2D2D7, #48484A);
        --acc: #FFCC38;
        --acc-pressed: #B88B14;
        --acc-ink: #241D0B;
        --ok: light-dark(#248A3D, #30D158);
        --bad: light-dark(#D70015, #FF453A);
        --warn: light-dark(#9A6700, #FFD60A);
    }
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--bg); color: var(--ink); font: 15px/1.55 -apple-system, BlinkMacSystemFont, "SF Pro Text", "Helvetica Neue", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif; -webkit-font-smoothing: antialiased; }
    .wrap { max-width: 720px; margin: 0 auto; padding: 40px 20px 60px; }
    .head { display: flex; gap: 14px; align-items: center; margin-bottom: 22px; }
    .mark { width: 44px; height: 44px; border-radius: 12px; background: var(--acc); color: var(--acc-ink); display: grid; place-items: center; font-weight: 700; font-size: 20px; }
    .head h1 { font-size: 19px; margin: 0; }
    .sub { margin: 2px 0 0; color: var(--mut); font-size: 13px; }
    .card { background: var(--card); border: 1px solid var(--line); border-radius: 16px; padding: 22px; margin-bottom: 16px; }
    h2 { font-size: 16px; margin: 0 0 12px; }
    table.checks { width: 100%; border-collapse: collapse; font-size: 14px; }
    .checks td { padding: 7px 0; border-bottom: 1px solid var(--line); vertical-align: top; }
    .checks tr:last-child td { border-bottom: none; }
    .dot { display: inline-block; width: 9px; height: 9px; border-radius: 50%; margin-right: 8px; vertical-align: middle; }
    .dot.ok { background: var(--ok); }
    .dot.bad { background: var(--bad); }
    .dot.warn { background: var(--warn); }
    .hint { color: var(--mut); font-size: 12.5px; }
    label.f { display: block; margin: 12px 0; }
    label.f > span { display: block; font-size: 13px; color: var(--mut); margin-bottom: 5px; }
    input[type="text"], input[type="password"], input[type="email"], input[type="number"] { width: 100%; padding: 10px 12px; border: 1px solid var(--line); border-radius: 10px; background: transparent; color: inherit; font: inherit; }
    input[type="text"]:focus-visible, input[type="password"]:focus-visible, input[type="email"]:focus-visible, input[type="number"]:focus-visible { outline: 2px solid var(--acc-pressed); outline-offset: 1px; }
    .check-inline { display: flex; gap: 8px; align-items: center; margin: 6px 0 0; font-size: 14px; color: var(--mut); }
    .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .btn { display: inline-block; padding: 10px 18px; border-radius: 10px; border: none; background: var(--acc); color: var(--acc-ink); font-weight: 600; font: inherit; font-size: 14.5px; cursor: pointer; text-decoration: none; }
    .btn.ghost { background: transparent; border: 1px solid var(--line); color: inherit; }
    .actions { display: flex; gap: 10px; align-items: center; margin-top: 16px; flex-wrap: wrap; }
    .alert { border: 1px solid var(--bad); color: var(--bad); border-radius: 12px; padding: 10px 14px; font-size: 14px; margin-bottom: 14px; }
    .alert.warn { border-color: var(--warn); color: var(--warn); }
    .notice { border: 1px solid var(--line); background: color-mix(in srgb, var(--acc) 12%, transparent); border-radius: 12px; padding: 10px 14px; font-size: 13.5px; margin-bottom: 14px; }
    .err { color: var(--bad); font-size: 12.5px; margin-top: 4px; display: block; }
    pre.env { background: rgba(0, 0, 0, 0.08); border: 1px solid var(--line); border-radius: 12px; padding: 14px; overflow: auto; font-size: 12.5px; max-height: 320px; }
    ul.plain { margin: 8px 0; padding-left: 18px; }
    ul.plain li { margin: 4px 0; }
    footer { text-align: center; color: var(--mut); font-size: 12.5px; margin-top: 26px; }
    @media (max-width: 560px) { .grid { grid-template-columns: 1fr; } }
</style>
</head>
<body>
<main class="wrap">
    <header class="head">
        <div class="mark">M</div>
        <div>
            <h1>MOFU社区 安装向导</h1>
            <p class="sub">{% if step %}第 {{ step }} / 3 步 · {{ title }}{% else %}{{ title }}{% endif %}</p>
        </div>
    </header>

    {% block content %}{% endblock %}

    <footer>MOFU社区 · 完成安装后向导将自动锁定</footer>
</main>
</body>
</html>
