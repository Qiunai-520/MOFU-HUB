<!doctype html>
<html lang="zh-CN" class="no-js" data-page="{% block page_id %}page{% endblock %}" data-appearance="{{ appearance|default('auto') }}"{% if navCompact %} data-nav-compact{% endif %}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="{{ appearance|default('auto') == 'dark' ? '#000000' : '#F5F5F7' }}">
<title>{% block title %}{{ app.name }}{% endblock %}</title>
<meta name="csrf-token" content="{{ csrfToken }}">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="manifest" href="/manifest.webmanifest">
<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="description" content="{% block meta_description %}{{ app.name }} - 校园社区平台{% endblock %}">
<link rel="canonical" href="{{ app.url }}{% block canonical_path %}{{ currentPath }}{% endblock %}">
<meta property="og:site_name" content="{{ app.name }}">
<meta property="og:type" content="{% block og_type %}website{% endblock %}">
<meta property="og:title" content="{% block og_title %}{{ app.name }}{% endblock %}">
<meta property="og:description" content="{% block og_description %}校园社区平台{% endblock %}">
<meta property="og:url" content="{{ app.url }}{% block og_path %}{{ currentPath }}{% endblock %}">
{% block og_extra %}{% endblock %}
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="{% block twitter_title %}{{ app.name }}{% endblock %}">
<meta name="twitter:description" content="{% block twitter_description %}校园社区平台{% endblock %}">
{% block json_ld %}{% endblock %}
<noscript><p style="padding:2rem;text-align:center">请启用 JavaScript 以正常使用本站。</p></noscript>
<script>
document.documentElement.classList.remove('no-js');
window.__MOFU__ = {
  csrf: {{ csrfToken|json_encode|raw }},
  user: {% if currentUser %}{"id": {{ currentUser.id }}, "username": {{ currentUser.username|json_encode|raw }}, "nickname": {{ currentUser.nickname|json_encode|raw }}, "email": {{ currentUser.email|json_encode|raw }}, "avatar_url": {{ currentUser.avatar_url|json_encode|raw }}, "profile_url": {{ ("/u/" ~ currentUser.username)|json_encode|raw }}, "can_admin": {{ currentUser.can_admin ? 'true' : 'false' }}}{% else %}null{% endif %},
  theme: {{ themeConfig|json_encode|raw }},
  upload: { maxMb: {{ upload.maxMb }}, videoMaxMb: {{ upload.videoMaxMb }} },
  twikoo: { envId: {{ twikooEnvId|json_encode|raw }}, scriptUrl: {{ twikooScriptUrl|json_encode|raw }}, lang: {{ twikooLang|json_encode|raw }}, emotionCdn: {{ twikooEmotionCdn|json_encode|raw }} },
  navPrimaryPaths: {{ navPrimaryPaths|json_encode|raw }}
};
</script>
{# 首帧外观：在样式表加载前把游客的本机偏好写回 <html>，避免刷新闪白。 #}
<script>
(function () {
  try {
    var mode = localStorage.getItem('mofu.appearance');
    var legacy = mode === null ? localStorage.getItem('mofu.theme.guest') : null;
    if (mode === null && legacy !== null) {
      var saved = JSON.parse(legacy);
      mode = saved && saved.state ? saved.state.scheme : null;
    }
    if (mode === 'light' || mode === 'dark' || mode === 'auto') {
      document.documentElement.dataset.appearance = mode;
      var meta = document.querySelector('meta[name="theme-color"]');
      var dark = mode === 'dark' || (mode === 'auto' && window.matchMedia('(prefers-color-scheme: dark)').matches);
      if (meta) meta.setAttribute('content', dark ? '#000000' : '#F5F5F7');
    }
  } catch (e) {}
})();
</script>
{{ vite_asset('src-client/main.ts') }}
</head>
<body class="mofu-body">
<div class="app-shell" id="app-theme">

<a class="skip-link" href="#swup">跳到主要内容</a>

<header class="app-header" data-app-header>
    <div class="app-header__inner">
        <button class="icon-btn nav-toggle" type="button" aria-label="打开导航菜单" aria-expanded="false" data-action="toggle-nav">
            <span class="material-symbols-outlined" aria-hidden="true">menu</span>
        </button>

        <a class="brand" href="/" data-nav-item="/">
            <span class="brand__name">{{ app.name }}</span>
        </a>

        <form class="global-search" method="get" action="/search" role="search">
            <span class="material-symbols-outlined global-search__icon" aria-hidden="true">search</span>
            <input class="global-search__input" type="search" name="q" placeholder="搜索动态、话题、同学…"
                   aria-label="全局搜索" autocomplete="off" maxlength="50">
        </form>

        <div class="app-header__actions">
            <a class="icon-btn global-search__toggle" href="/search" aria-label="搜索">
                <span class="material-symbols-outlined" aria-hidden="true">search</span>
            </a>
            {% if currentUser %}
            <details class="account-menu" data-account-menu>
                <summary class="account-menu__trigger" aria-label="{{ currentUser.nickname }} 的账户菜单">
                    {{ include('components/avatar.twig', { user: currentUser, size: 'sm' }) }}
                    <span class="account-menu__name">{{ currentUser.nickname }}{{ include('components/name-badge.twig', { user: currentUser }) }}</span>
                    <span class="account-menu__chevron material-symbols-outlined" aria-hidden="true">expand_more</span>
                </summary>
                <div class="account-menu__panel">
                    <div class="account-menu__head">
                        <strong>{{ currentUser.nickname }}</strong>
                        <span>@{{ currentUser.username }}</span>
                    </div>
                    <a class="account-menu__item" href="/messages">
                        <span class="material-symbols-outlined" aria-hidden="true">chat</span>
                        <span>消息</span>
                        <span class="nav-badge nav-badge--offset" data-message-badge hidden></span>
                    </a>
                    <a class="account-menu__item" href="/me">
                        <span class="material-symbols-outlined" aria-hidden="true">person</span><span>我的主页</span>
                    </a>
                    <a class="account-menu__item" href="/settings">
                        <span class="material-symbols-outlined" aria-hidden="true">settings</span><span>设置</span>
                    </a>
                    {% if currentUser.can_admin %}
                    <a class="account-menu__item" href="/admin/dashboard">
                        <span class="material-symbols-outlined" aria-hidden="true">admin_panel_settings</span><span>管理后台</span>
                    </a>
                    {% endif %}
                    <form method="post" action="/logout" class="account-menu__form">
                        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                        <button class="account-menu__item account-menu__item--button" type="submit">
                            <span class="material-symbols-outlined" aria-hidden="true">logout</span><span>退出登录</span>
                        </button>
                    </form>
                </div>
            </details>
            {% endif %}
            {% if not currentUser %}
                <a class="text-btn" href="/login"><span data-i18n="header.login">登录</span></a>
                <a class="filled-btn filled-btn--sm" href="/register"><span data-i18n="header.register">注册</span></a>
            {% endif %}
        </div>
    </div>
</header>

<div class="app-body">
    <aside class="side-nav" id="side-nav" data-side-nav aria-label="侧边导航">
        <div class="side-nav__brand">
            <span class="brand-mark brand-mark--sm" aria-hidden="true">
                <img src="/logo.png" alt="" width="26" height="26" loading="lazy" decoding="async">
            </span>
            <span class="side-nav__brand-name">{{ app.name }}</span>
        </div>
        <nav class="side-nav__group">
            <p class="side-nav__label" data-i18n="nav.browse">浏览</p>
            <a class="side-nav__item" href="/boards" data-nav-item="/boards">
                <span class="material-symbols-outlined" aria-hidden="true">dashboard</span><span data-i18n="nav.boards">板块</span>
            </a>
            <a class="side-nav__item" href="/wall" data-nav-item="/wall">
                <span class="material-symbols-outlined" aria-hidden="true">favorite</span><span data-i18n="nav.wall">表白墙</span>
            </a>
            <a class="side-nav__item" href="/hole" data-nav-item="/hole">
                <span class="material-symbols-outlined" aria-hidden="true">forest</span><span data-i18n="nav.hole">树洞</span>
            </a>
            <a class="side-nav__item" href="/circles" data-nav-item="/circles">
                <span class="material-symbols-outlined" aria-hidden="true">groups</span><span data-i18n="nav.circles">圈子</span>
            </a>
            <a class="side-nav__item" href="/konbini" data-nav-item="/konbini">
                <span class="material-symbols-outlined" aria-hidden="true">view_in_ar</span><span>3D 街景</span>
            </a>
            <a class="side-nav__item" href="/events" data-nav-item="/events">
                <span class="material-symbols-outlined" aria-hidden="true">event</span><span data-i18n="nav.events">活动</span>
            </a>
            <a class="side-nav__item" href="/news" data-nav-item="/news">
                <span class="material-symbols-outlined" aria-hidden="true">newspaper</span><span data-i18n="nav.news">资讯</span>
            </a>
            <a class="side-nav__item" href="/music" data-nav-item="/music">
                <span class="material-symbols-outlined" aria-hidden="true">music_note</span><span>音乐</span>
            </a>
            {% if currentUser %}
            <a class="side-nav__cta filled-btn" href="/compose">
                <span class="material-symbols-outlined" aria-hidden="true">edit_square</span><span data-i18n="nav.compose_cta">发布动态</span>
            </a>
            {% else %}
            <a class="side-nav__cta filled-btn" href="/register">加入 {{ app.name }}</a>
            <a class="side-nav__item" href="/login" data-nav-item="/login">
                <span class="material-symbols-outlined" aria-hidden="true">login</span><span data-i18n="nav.login">登录</span>
            </a>
            {% endif %}
        </nav>
    </aside>

    <div class="side-nav-scrim" data-nav-scrim hidden></div>

    {% if background and background.url %}
    {# URL 必须用 CSS 转义 + CSS 字符串引号：js 转义会把 : 写成 \u003A，在 url() 里退化成 u003A #}
    <div class="site-background" aria-hidden="true"
         style="background-image: url(&quot;{{ background.url|e('css') }}&quot;); opacity: {{ background.opacity }}%"></div>
    {% endif %}

    <main id="swup" class="page-main transition-swup" data-page-content tabindex="-1">
        {# 换页时 swup 只替换本容器，html[data-page] 不会更新；此标记供前端同步页面标识 #}
        <span data-page-marker data-page="{{ block('page_id') }}" hidden></span>
        {% block content %}{% endblock %}
    </main>
</div>

<footer class="site-footer">
    <div class="site-footer__inner">
        <div class="site-footer__brand">
            <span class="brand-mark brand-mark--sm" aria-hidden="true">
                <img src="/logo.png" alt="" width="26" height="26" loading="lazy" decoding="async">
            </span>
            <div class="site-footer__meta">
                <strong>{{ app.name }}</strong>
                <span data-i18n="footer.tagline">分享校园生活 · 记录每一份心情</span>
            </div>
        </div>
        <p class="site-footer__copy">© {{ "now"|date("Y") }} {{ app.name }} · v{{ app.version }}</p>
    </div>
</footer>

<div class="fab-stack" data-fab-stack>
    {% if currentUser %}
    <a class="fab-compose" href="/compose" aria-label="发布动态">
        <span class="material-symbols-outlined" aria-hidden="true">edit_square</span>
        <span>发布</span>
    </a>
    {% endif %}
    {% if musicAppUrl is not empty %}
    <button class="fab-btn fab-music" type="button" data-action="toggle-music" aria-label="打开音乐播放器"
            aria-expanded="false" aria-controls="music-dock-panel">
        <span class="material-symbols-outlined" aria-hidden="true">music_note</span>
    </button>
    {% endif %}
    {# 回到顶部：并入悬浮按钮栈（滚动足够多才出现，默认 hidden） #}
    <button class="fab-btn back-to-top" id="back-to-top" type="button" hidden data-action="back-to-top" aria-label="回到顶部">
        <span class="material-symbols-outlined" aria-hidden="true">arrow_upward</span>
    </button>
</div>

<nav class="bottom-nav" aria-label="主导航">
    <div class="bottom-nav__bar">
        <span class="bottom-nav__thumb" data-bottom-nav-thumb aria-hidden="true"></span>
        <a class="bottom-nav__item" href="/" data-nav-item="/">
            <span class="material-symbols-outlined" aria-hidden="true">home</span><span class="bottom-nav__label" data-i18n="nav.home">主页</span>
        </a>
        <a class="bottom-nav__item" href="/boards" data-nav-item="/boards">
            <span class="material-symbols-outlined" aria-hidden="true">dashboard</span><span class="bottom-nav__label" data-i18n="nav.boards">板块</span>
        </a>
        <a class="bottom-nav__item" href="/messages" data-nav-item="/messages">
            <span class="material-symbols-outlined" aria-hidden="true">chat</span><span class="bottom-nav__label" data-i18n="nav.messages">消息</span>
            <span class="bottom-nav__badge-wrap"><span class="nav-badge" data-unread-badge hidden></span><span class="nav-badge nav-badge--offset" data-message-badge hidden></span></span>
        </a>
        <a class="bottom-nav__item" href="/me" data-nav-item="/me">
            <span class="material-symbols-outlined" aria-hidden="true">person</span><span class="bottom-nav__label" data-i18n="nav.profile">我的</span>
        </a>
    </div>
</nav>

{% if musicAppUrl is not empty %}
<div class="music-dock" id="music-dock-panel" data-music-dock>
    <section class="music-dock__panel" data-music-panel aria-hidden="true">
        <header class="music-dock__head">
            <span class="music-dock__title">
                <span class="material-symbols-outlined" aria-hidden="true">graphic_eq</span>
                MOFU 音乐
            </span>
            <span class="music-dock__hint">播放会随页面保持</span>
            <a class="icon-btn icon-btn--sm" href="{{ musicAppUrl }}" target="_blank" rel="noopener" aria-label="在新窗口打开音乐">
                <span class="material-symbols-outlined" aria-hidden="true">open_in_new</span>
            </a>
            <button class="icon-btn icon-btn--sm" type="button" data-action="close-music" aria-label="收起音乐播放器">
                <span class="material-symbols-outlined" aria-hidden="true">close</span>
            </button>
        </header>
        <iframe class="music-dock__frame" data-music-frame data-src="{{ musicAppUrl }}"
                title="MOFU 音乐播放器" allow="autoplay; clipboard-write; encrypted-media; fullscreen"
                loading="lazy"></iframe>
    </section>
</div>
{% endif %}

<div class="toast-host" id="toast-host" aria-live="polite"></div>
<div class="lightbox" id="lightbox" hidden>
    <button class="lightbox__close icon-btn" type="button" aria-label="关闭预览" data-action="close-lightbox">
        <span class="material-symbols-outlined" aria-hidden="true">close</span>
    </button>
    <img class="lightbox__img" src="" alt="" loading="lazy" decoding="async">
    <video class="lightbox__video" controls playsinline hidden></video>
</div>

<div class="page-loading" data-page-loading aria-hidden="true" hidden>
    <span class="mofu-spinner"></span>
</div>
</div>
</body>
</html>
