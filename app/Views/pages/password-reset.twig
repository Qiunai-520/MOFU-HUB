{% extends 'layouts/app.twig' %}

{% block page_id %}password-reset{% endblock %}
{% block title %}设置密码 · {{ app.name }}{% endblock %}

{% block content %}
<div class="auth-layout">
    <section class="auth-card">
        <h1 class="auth-card__title">通过邮箱设置密码</h1>

        {% if step == 'email' %}
        <p class="auth-card__subtitle">输入注册邮箱，我们会发送验证码；验证后即可设置新密码</p>

        {% if not mailConfigured %}
        <div class="form-alert" role="alert">当前邮件服务未配置（MAIL_MAILER=log），验证码会写入服务器日志，仅供本地调试。</div>
        {% endif %}

        {% if errors.email is defined %}
        <div class="form-alert" role="alert">{{ errors.email }}</div>
        {% endif %}

        <form method="post" action="/password/reset" class="auth-form" novalidate>
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            <label class="field{{ errors.email is defined ? ' field--error' : '' }}" for="reset-email">
                <span class="field__label">邮箱</span>
                <input class="field__input" id="reset-email" type="email" name="email" value="{{ values.email }}"
                       autocomplete="email" required autofocus>
            </label>
            <button class="filled-btn filled-btn--block" type="submit">发送验证码</button>
        </form>

        {% else %}
        <p class="auth-card__subtitle">验证码已发送到 <strong>{{ values.email }}</strong>，请设置新密码</p>

        {% for key, message in errors %}<div class="form-alert" role="alert">{{ message }}</div>{% endfor %}

        <form method="post" action="/password/reset/verify" class="auth-form" novalidate>
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            <input type="hidden" name="email" value="{{ values.email }}">

            <label class="field{{ errors.code is defined ? ' field--error' : '' }}" for="reset-code">
                <span class="field__label">验证码</span>
                <input class="field__input" id="reset-code" type="text" name="code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required autofocus>
            </label>

            <label class="field{{ errors.password is defined ? ' field--error' : '' }}" for="reset-password">
                <span class="field__label">新密码</span>
                <input class="field__input" id="reset-password" type="password" name="password" autocomplete="new-password" minlength="8" required>
                <span class="field__hint">至少 8 位</span>
            </label>

            <label class="field{{ errors.password_confirm is defined ? ' field--error' : '' }}" for="reset-password-confirm">
                <span class="field__label">确认新密码</span>
                <input class="field__input" id="reset-password-confirm" type="password" name="password_confirm" autocomplete="new-password" required>
            </label>

            <button class="filled-btn filled-btn--block" type="submit">设置密码</button>
        </form>

        <form method="post" action="/password/reset" class="auth-form auth-form--inline">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            <input type="hidden" name="email" value="{{ values.email }}">
            <button class="text-btn" type="submit">重新发送验证码</button>
        </form>
        {% endif %}

        <p class="auth-card__foot"><a href="/login">返回登录</a></p>
    </section>
</div>
{% endblock %}
