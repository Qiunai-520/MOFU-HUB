{% extends 'layouts/app.twig' %}

{% block page_id %}events{% endblock %}
{% block title %}校园活动 · {{ app.name }}{% endblock %}

{% block content %}
<section class="events-page">
    <header class="page-head">
        <div>
            <h1 class="page-title">校园活动</h1>
            <p class="page-subtitle">发现并参与校园里的精彩活动</p>
        </div>
        {% if currentUser %}
        <div class="page-head__actions">
            <a class="tonal-btn tonal-btn--sm" href="/events/mine">我的活动</a>
            <a class="filled-btn filled-btn--sm" href="/events/new">
                <span class="material-symbols-outlined" aria-hidden="true">add</span> 发起活动
            </a>
        </div>
        {% endif %}
    </header>

    <nav class="feed-tabs" aria-label="活动时间筛选" data-swup-persist="events-tabs">
        <a class="feed-tab{{ tab == 'upcoming' ? ' is-active' : '' }}"{{ tab == 'upcoming' ? ' aria-current="page"' : '' }} href="/events?tab=upcoming">即将开始</a>
        <a class="feed-tab{{ tab == 'ongoing' ? ' is-active' : '' }}"{{ tab == 'ongoing' ? ' aria-current="page"' : '' }} href="/events?tab=ongoing">进行中</a>
        <a class="feed-tab{{ tab == 'past' ? ' is-active' : '' }}"{{ tab == 'past' ? ' aria-current="page"' : '' }} href="/events?tab=past">已结束</a>
        <a class="feed-tab{{ tab == 'all' ? ' is-active' : '' }}"{{ tab == 'all' ? ' aria-current="page"' : '' }} href="/events?tab=all">全部</a>
    </nav>

    <div class="events-panel" data-tabs-panel>
    <div class="event-grid" data-list="events">
        {% for event in events.items %}
            {{ include('components/event-card.twig', { event: event }) }}
        {% else %}
        {{ include('components/empty-state.twig', {
            icon: 'event',
            title: '这里还没有活动',
            text: currentUser ? '发起一场活动，邀请同学们参加吧' : '注册后即可发起活动',
            cta_href: currentUser ? '/events/new' : '/register',
            cta_label: currentUser ? '发起活动' : '立即注册',
        }) }}
        {% endfor %}
    </div>

    {{ include('components/load-more.twig', { pagination: events, base: baseUrl, target: 'events' }) }}
    </div>
</section>
{% endblock %}
