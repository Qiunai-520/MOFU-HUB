{% extends 'layouts/app.twig' %}

{% block page_id %}news{% endblock %}
{% block title %}校园资讯 · {{ app.name }}{% endblock %}

{% block content %}
<section class="news-page">
    <header class="page-head">
        <div>
            <h1 class="page-title">校园资讯</h1>
            <p class="page-subtitle">通知公告、校园新闻与学习资源</p>
        </div>
    </header>

    <nav class="feed-tabs" aria-label="资讯分类">
        <a class="feed-tab{{ category == '' ? ' is-active' : '' }}"{{ category == '' ? ' aria-current="page"' : '' }} href="/news">全部</a>
        <a class="feed-tab{{ category == 'notice' ? ' is-active' : '' }}"{{ category == 'notice' ? ' aria-current="page"' : '' }} href="/news?category=notice">通知公告</a>
        <a class="feed-tab{{ category == 'campus' ? ' is-active' : '' }}"{{ category == 'campus' ? ' aria-current="page"' : '' }} href="/news?category=campus">校园新闻</a>
        <a class="feed-tab{{ category == 'resource' ? ' is-active' : '' }}"{{ category == 'resource' ? ' aria-current="page"' : '' }} href="/news?category=resource">学习资源</a>
    </nav>

    <div class="news-list" data-list="news">
        {% for item in news.items %}
            {{ include('components/news-card.twig', { news: item }) }}
        {% else %}
        {{ include('components/empty-state.twig', {
            icon: 'newspaper',
            title: '还没有资讯',
            text: '校园资讯由管理员发布，敬请期待',
        }) }}
        {% endfor %}
    </div>

    {{ include('components/load-more.twig', { pagination: news, base: baseUrl, target: 'news' }) }}
</section>
{% endblock %}
