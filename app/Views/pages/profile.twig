{% extends 'layouts/app.twig' %}

{% block page_id %}profile{% endblock %}
{% block title %}{{ profile.nickname }} · {{ app.name }}{% endblock %}

{% block content %}
<div class="profile-page">
    {# ============================ Profile Hero ============================
       一级：封面 / 头像 / 用户名 / 等级 / 称号
       二级：签名 / 地区 / 加入时间
       三级：数据统计（动态 / 获赞 / 关注 / 粉丝）
       四级：操作按钮（主 / 次 / 更多菜单）
       未设置封面时用默认渐变，文字可读性由 scrim 与颜色令牌共同保证。
    #}
    <header class="profile-hero{{ profile.cover_url is empty ? ' profile-hero--default' : '' }}">
        <div class="profile-hero__cover"{% if profile.cover_url is not empty %} style="background-image: url('{{ profile.cover_url|e('css') }}')"{% endif %} aria-hidden="true">
            <span class="profile-hero__scrim"></span>
        </div>

        <div class="profile-hero__body">
            <div class="profile-hero__avatar">
                {{ include('components/avatar.twig', { user: profile, size: 'xl' }) }}
            </div>

            <div class="profile-hero__identity">
                <h1 class="profile-hero__name{{ profile.is_premium ? ' is-premium' : '' }}">{{ profile.nickname }}{{ include('components/name-badge.twig', { user: profile }) }}</h1>
                <p class="profile-hero__handle">
                    <span class="profile-hero__at">@{{ profile.username }}</span>
                    <span class="profile-hero__mid">#{{ profile.mid }}</span>
                    {% if profile.is_formal %}<span class="level-chip{{ profile.is_flash ? ' level-chip--flash' : '' }}">{% if profile.is_flash %}<span class="material-symbols-outlined" aria-hidden="true">bolt</span>{% endif %}Lv.{{ profile.level_number }}</span>{% endif %}
                    {% if profile.is_premium %}<span class="level-chip level-chip--premium">大会员</span>{% endif %}
                    {% if profile.title is not null %}
                    <span class="level-chip"><span class="material-symbols-outlined" aria-hidden="true">{{ profile.title.icon }}</span>{{ profile.title.name }}</span>
                    {% endif %}
                </p>

                {% if profile.bio is not empty %}
                <p class="profile-hero__bio">{{ profile.bio }}</p>
                {% endif %}

                <p class="profile-hero__meta">
                    {% if profile.location is not empty %}
                    <span class="profile-hero__meta-item"><span class="material-symbols-outlined" aria-hidden="true">location_on</span>{{ profile.location }}</span>
                    {% endif %}
                    <span class="profile-hero__meta-item"><span class="material-symbols-outlined" aria-hidden="true">calendar_month</span>{{ profile.joined_at }} 加入</span>
                    {% if profile.website is not empty %}
                    <a class="profile-hero__meta-item" href="{{ profile.website }}" target="_blank" rel="nofollow noopener">
                        <span class="material-symbols-outlined" aria-hidden="true">link</span>{{ profile.website }}
                    </a>
                    {% endif %}
                </p>
            </div>

            <div class="profile-hero__actions">
                {% if profile.is_self %}
                <a class="filled-btn profile-btn" href="/settings/profile">
                    <span class="material-symbols-outlined" aria-hidden="true">edit</span> 编辑资料
                </a>
                <button class="outlined-btn profile-btn" type="button" data-action="share" data-share-url="/u/{{ profile.username }}">
                    <span class="material-symbols-outlined" aria-hidden="true">share</span> 分享
                </button>
                {% else %}
                {% if profile.can_message %}
                <a class="filled-btn profile-btn" href="/messages/with/{{ profile.username }}">
                    <span class="material-symbols-outlined" aria-hidden="true">mail</span> 私信
                </a>
                {% endif %}
                <button class="{{ profile.is_following ? 'outlined-btn' : 'filled-btn' }} follow-btn follow-btn--lg profile-btn{{ profile.is_following ? ' is-following' : '' }}" type="button"
                        data-action="toggle-follow" data-user-id="{{ profile.id }}" data-follow-size="lg"
                        aria-pressed="{{ profile.is_following ? 'true' : 'false' }}">
                    {{ profile.is_following ? '已关注' : '关注' }}
                </button>
                {# 拉黑 / 举报 / 分享收进「更多」菜单，不再裸露在页面上 #}
                <details class="profile-more">
                    <summary class="icon-btn profile-more__trigger" aria-label="更多操作">
                        <span class="material-symbols-outlined" aria-hidden="true">more_horiz</span>
                    </summary>
                    <div class="profile-more__menu" role="menu">
                        <button class="profile-more__item" type="button" role="menuitem" data-action="share" data-share-url="/u/{{ profile.username }}">分享主页</button>
                        <button class="profile-more__item{{ profile.is_blocked ? ' is-blocked' : '' }}" type="button" role="menuitem"
                                data-action="toggle-block" data-user-id="{{ profile.id }}">{{ profile.is_blocked ? '解除拉黑' : '拉黑' }}</button>
                        {% if currentUser %}
                        <button class="profile-more__item profile-more__item--danger" type="button" role="menuitem"
                                data-action="report" data-target-type="user" data-target-id="{{ profile.id }}">举报</button>
                        {% endif %}
                    </div>
                </details>
                {% endif %}
            </div>

            <dl class="profile-hero__stats">
                <div class="profile-stat"><dt>动态</dt><dd>{{ profile.posts_count }}</dd></div>
                <div class="profile-stat"><dt>获赞</dt><dd>{{ profile.likes_received }}</dd></div>
                <div class="profile-stat"><dt>关注</dt><dd>{{ profile.following_count }}</dd></div>
                <div class="profile-stat"><dt>粉丝</dt><dd>{{ profile.followers_count }}</dd></div>
            </dl>
        </div>
    </header>

    {# ============================ Tab 导航 ============================ #}
    <nav class="profile-tabs" aria-label="个人主页导航" data-swup-persist="profile-tabs">
        <a class="profile-tab{{ tab == 'posts' ? ' is-active' : '' }}"{{ tab == 'posts' ? ' aria-current="page"' : '' }} href="/u/{{ profile.username }}?tab=posts" data-tab-default>动态</a>
        {% if profile.is_self %}
        <a class="profile-tab{{ tab == 'favorites' ? ' is-active' : '' }}"{{ tab == 'favorites' ? ' aria-current="page"' : '' }} href="/u/{{ profile.username }}?tab=favorites">收藏</a>
        <a class="profile-tab{{ tab == 'likes' ? ' is-active' : '' }}"{{ tab == 'likes' ? ' aria-current="page"' : '' }} href="/u/{{ profile.username }}?tab=likes">点赞</a>
        <a class="profile-tab{{ tab == 'comments' ? ' is-active' : '' }}"{{ tab == 'comments' ? ' aria-current="page"' : '' }} href="/u/{{ profile.username }}?tab=comments">评论</a>
        {% endif %}
        <a class="profile-tab{{ tab == 'following' ? ' is-active' : '' }}"{{ tab == 'following' ? ' aria-current="page"' : '' }} href="/u/{{ profile.username }}?tab=following">关注</a>
        <a class="profile-tab{{ tab == 'followers' ? ' is-active' : '' }}"{{ tab == 'followers' ? ' aria-current="page"' : '' }} href="/u/{{ profile.username }}?tab=followers">粉丝</a>
    </nav>

    {# ============================ 内容 + 侧栏 ============================ #}
    <div class="profile-body">
        <div class="profile-main" data-tabs-panel>
            {% if tab == 'posts' %}
            <section class="feed">
                {% if allPosts %}
                {# 全部动态页：右上角可按内容搜索 #}
                <form class="profile-post-search" method="get" action="/u/{{ profile.username }}/posts" role="search">
                    <span class="material-symbols-outlined" aria-hidden="true">search</span>
                    <input type="search" name="q" value="{{ keyword }}" placeholder="搜索 {{ profile.nickname }} 的动态…" maxlength="50" aria-label="搜索动态">
                    <button class="text-btn text-btn--sm" type="submit">搜索</button>
                </form>
                {% else %}
                <a class="profile-more-posts" href="/u/{{ profile.username }}/posts">
                    <span class="material-symbols-outlined" aria-hidden="true">list</span>查看更多帖子
                </a>
                {% endif %}
                <div class="feed-list" data-list="profile-posts">
                    {% for post in feedItems %}
                        {{ include('components/post-card.twig', { post: post }) }}
                    {% else %}
                    {{ include('components/empty-state.twig', {
                        icon: 'article',
                        title: allPosts and keyword is not empty ? '没有匹配的动态' : '还没有动态',
                        cta_href: profile.is_self ? '/compose' : '',
                        cta_label: '发布第一条',
                    }) }}
                    {% endfor %}
                </div>
                {% if allPosts %}
                {{ include('components/load-more.twig', { pagination: feed, base: '/u/' ~ profile.username ~ '/posts?q=' ~ (keyword|url_encode) ~ '&', target: 'profile-posts' }) }}
                {% endif %}
            </section>

            {% elseif tab == 'favorites' %}
            <section class="favorites">
                {% if not canViewFavorites %}
                {{ include('components/empty-state.twig', { icon: 'lock', title: '收藏仅本人可见' }) }}
                {% else %}
                <h2 class="feed__title">收藏的动态</h2>
                <div class="feed-list">
                    {% for post in favoritePosts %}
                        {{ include('components/post-card.twig', { post: post }) }}
                    {% else %}
                    {{ include('components/empty-state.twig', {
                        icon: 'bookmark',
                        title: '还没有收藏动态',
                        text: '在动态卡片上点击书签图标即可收藏',
                    }) }}
                    {% endfor %}
                </div>

                <h2 class="feed__title">收藏的表白 / 树洞</h2>
                <div class="board__list">
                    {% for item in favoriteConfessions %}
                        {{ include('components/confession-card.twig', { item: item }) }}
                    {% else %}
                    {{ include('components/empty-state.twig', { icon: 'favorite', title: '还没有收藏的投稿' }) }}
                    {% endfor %}
                </div>
                {% endif %}
            </section>

            {% elseif tab == 'likes' %}
            <section class="favorites">
                {% if not canViewPrivate %}
                {{ include('components/empty-state.twig', { icon: 'lock', title: '点赞仅本人可见' }) }}
                {% else %}
                <h2 class="feed__title">点赞的动态</h2>
                <div class="feed-list">
                    {% for post in likedPosts %}
                        {{ include('components/post-card.twig', { post: post }) }}
                    {% else %}
                    {{ include('components/empty-state.twig', {
                        icon: 'favorite',
                        title: '还没有点赞动态',
                        text: '在动态卡片上点击爱心即可点赞',
                    }) }}
                    {% endfor %}
                </div>

                <h2 class="feed__title">点赞的表白 / 树洞</h2>
                <div class="board__list">
                    {% for item in likedConfessions %}
                        {{ include('components/confession-card.twig', { item: item }) }}
                    {% else %}
                    {{ include('components/empty-state.twig', { icon: 'favorite', title: '还没有点赞投稿' }) }}
                    {% endfor %}
                </div>
                {% endif %}
            </section>

            {% elseif tab == 'comments' %}
            <section class="my-comments">
                {% if not canViewPrivate %}
                {{ include('components/empty-state.twig', { icon: 'lock', title: '评论仅本人可见' }) }}
                {% elseif myComments|length == 0 and myConfessionComments|length == 0 %}
                {{ include('components/empty-state.twig', {
                    icon: 'forum',
                    title: '还没有发表过评论',
                    text: '去首页看看大家的动态，参与讨论吧',
                }) }}
                {% else %}
                <div class="my-comment-list">
                    {% for c in myComments %}
                    <article class="my-comment">
                        <div class="my-comment__meta">
                            <span class="meta-chip">{{ c.label }}</span>
                            <time class="my-comment__time">{{ c.time_ago }}</time>
                        </div>
                        <p class="my-comment__content">{{ c.excerpt }}</p>
                        <div class="my-comment__foot">
                            {% if c.available %}
                            <a class="text-btn text-btn--sm" href="{{ c.url }}">查看来源</a>
                            {% else %}
                            <span class="my-comment__gone">来源已不可见</span>
                            {% endif %}
                        </div>
                    </article>
                    {% endfor %}
                    {% for c in myConfessionComments %}
                    <article class="my-comment">
                        <div class="my-comment__meta">
                            <span class="meta-chip">{{ c.label }}</span>
                            <time class="my-comment__time">{{ c.time_ago }}</time>
                        </div>
                        <p class="my-comment__content">{{ c.excerpt }}</p>
                        <div class="my-comment__foot">
                            {% if c.available %}
                            <a class="text-btn text-btn--sm" href="{{ c.url }}">查看来源</a>
                            {% else %}
                            <span class="my-comment__gone">来源已不可见</span>
                            {% endif %}
                        </div>
                    </article>
                    {% endfor %}
                </div>
                {% endif %}
            </section>

            {% elseif tab == 'following' or tab == 'followers' %}
            <section class="connections">
                {% if connectionsHidden %}
                <div class="empty-state">
                    <span class="material-symbols-outlined empty-state__icon" aria-hidden="true">lock</span>
                    <p class="empty-state__title">对方设置了隐私保护</p>
                    <p class="empty-state__text">关注与粉丝列表仅本人可见</p>
                </div>
                {% else %}
                <h2 class="feed__title">{{ tab == 'following' ? '关注的人' : '粉丝' }}</h2>
                <div class="user-list" data-list="profile-connections">
                    {% for user in connections.items %}
                        {{ include('components/user-card.twig', { user: user }) }}
                    {% else %}
                    <div class="empty-state">
                        <span class="material-symbols-outlined empty-state__icon" aria-hidden="true">group</span>
                        <p class="empty-state__title">{{ tab == 'following' ? '还没有关注任何人' : '还没有粉丝' }}</p>
                        {% if tab == 'following' and profile.is_self %}
                        <p class="empty-state__text">去首页看看大家的动态，关注感兴趣的同学</p>
                        <a class="filled-btn" href="/">去发现</a>
                        {% endif %}
                    </div>
                    {% endfor %}
                </div>
                {{ include('components/load-more.twig', { pagination: connections, base: tabUrl ~ 'tab=' ~ tab ~ '&', target: 'profile-connections' }) }}
                {% endif %}
            </section>
            {% endif %}
        </div>

        {# 侧栏：社区信息。技术字段（MID）收进折叠区，不占一级视觉。 #}
        <aside class="profile-side">
            <section class="profile-card">
                <h2 class="profile-card__title">社区信息</h2>
                <dl class="profile-facts">
                    <div class="profile-fact"><dt>加入时间</dt><dd>{{ profile.joined_at }}</dd></div>
                    {% if profile.location is not empty %}
                    <div class="profile-fact"><dt>地区</dt><dd>{{ profile.location }}</dd></div>
                    {% endif %}
                    <div class="profile-fact"><dt>动态</dt><dd>{{ profile.posts_count }}</dd></div>
                    <div class="profile-fact"><dt>获赞</dt><dd>{{ profile.likes_received }}</dd></div>
                </dl>

                {% if profile.is_self %}
                <details class="profile-facts-more">
                    <summary>账号信息</summary>
                    <dl class="profile-facts">
                        <div class="profile-fact"><dt>MID</dt><dd>#{{ profile.mid }}</dd></div>
                        <div class="profile-fact"><dt>用户名</dt><dd>@{{ profile.username }}</dd></div>
                    </dl>
                </details>
                {% endif %}
            </section>
        </aside>
    </div>
</div>
{% endblock %}
