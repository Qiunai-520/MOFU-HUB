{% extends 'layouts/app.twig' %}

{% block page_id %}me{% endblock %}
{% block title %}个人资料 · {{ app.name }}{% endblock %}

{% block content %}
<section class="me-page">
    <header class="me-hero card">
        {{ include('components/avatar.twig', { user: profile, size: 'xl' }) }}
        <div class="me-hero__info">
            <h1 class="me-hero__name">{{ profile.nickname }}</h1>
            <p class="me-hero__username">@{{ profile.username }}</p>
            {% if profile.bio is not empty %}
            <p class="me-hero__bio">{{ profile.bio }}</p>
            {% else %}
            <p class="me-hero__bio me-hero__bio--empty">还没有简介，去设置里写一句吧</p>
            {% endif %}
            <p class="me-hero__counts">{{ profile.following_count }} 关注 · {{ profile.followers_count }} 粉丝</p>
        </div>
        <a class="outlined-btn outlined-btn--sm me-hero__edit" href="/settings/profile">
            <span class="material-symbols-outlined" aria-hidden="true">edit</span> 编辑资料
        </a>
    </header>

    <div class="me-list card">
        {% if currentUser.can_admin %}
        <a class="me-item" href="/admin">
            <span class="material-symbols-outlined" aria-hidden="true">admin_panel_settings</span>
            <span class="me-item__label">MOFU 后台管理</span>
            <span class="material-symbols-outlined me-item__chevron" aria-hidden="true">chevron_right</span>
        </a>
        {% endif %}
        <a class="me-item" href="/u/{{ profile.username }}">
            <span class="material-symbols-outlined" aria-hidden="true">person</span>
            <span class="me-item__label">我的主页</span>
            <span class="material-symbols-outlined me-item__chevron" aria-hidden="true">chevron_right</span>
        </a>
        <a class="me-item" href="/settings/profile">
            <span class="material-symbols-outlined" aria-hidden="true">settings</span>
            <span class="me-item__label">设置</span>
            <span class="material-symbols-outlined me-item__chevron" aria-hidden="true">chevron_right</span>
        </a>
        <a class="me-item" href="/my/confessions">
            <span class="material-symbols-outlined" aria-hidden="true">article</span>
            <span class="me-item__label">我的投稿</span>
            <span class="material-symbols-outlined me-item__chevron" aria-hidden="true">chevron_right</span>
        </a>
        <a class="me-item" href="/history">
            <span class="material-symbols-outlined" aria-hidden="true">history</span>
            <span class="me-item__label">浏览记录</span>
            <span class="material-symbols-outlined me-item__chevron" aria-hidden="true">chevron_right</span>
        </a>
        <a class="me-item" href="/about">
            <span class="material-symbols-outlined" aria-hidden="true">info</span>
            <span class="me-item__label">关于 {{ app.name }}</span>
            <span class="material-symbols-outlined me-item__chevron" aria-hidden="true">chevron_right</span>
        </a>
    </div>
</section>
{% endblock %}
