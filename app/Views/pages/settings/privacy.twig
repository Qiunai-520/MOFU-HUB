{% extends 'layouts/app.twig' %}

{% block page_id %}settings{% endblock %}
{% block title %}隐私设置 · {{ app.name }}{% endblock %}

{% block content %}
<section class="settings-layout">
    {{ include('components/settings-nav.twig') }}

    <div class="settings-main" data-tabs-panel>
        <h1 class="page-title">隐私设置</h1>
        <p class="page-subtitle">切换即自动保存，不需要再点保存按钮。</p>

        {% if saved %}
        <div class="form-success" role="status">已保存</div>
        {% endif %}

        <form method="post" action="/settings/privacy" class="settings-form" data-auto-save>
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">

            <div class="settings-group">
                <h2 class="settings-group__title">谁能给我发私信</h2>
                <div class="settings-card">
                    <div class="settings-row">
                        <span class="settings-row__text"><strong>私信权限</strong>决定谁可以给你发私信</span>
                        <span class="segmented segmented--radio" role="radiogroup" aria-label="私信权限">
                            <label class="segmented__item"><input type="radio" name="dm_policy" value="all" {{ prefs.dm_policy == 'all' ? 'checked' : '' }}><span>所有人</span></label>
                            <label class="segmented__item"><input type="radio" name="dm_policy" value="mutual" {{ prefs.dm_policy == 'mutual' ? 'checked' : '' }}><span>互相关注</span></label>
                            <label class="segmented__item"><input type="radio" name="dm_policy" value="none" {{ prefs.dm_policy == 'none' ? 'checked' : '' }}><span>不接收</span></label>
                        </span>
                    </div>
                </div>
            </div>

            <div class="settings-group">
                <h2 class="settings-group__title">关注与粉丝列表可见性</h2>
                <div class="settings-card">
                    <div class="settings-row">
                        <span class="settings-row__text"><strong>列表可见性</strong>谁可以浏览你的关注与粉丝列表</span>
                        <span class="segmented segmented--radio" role="radiogroup" aria-label="关注与粉丝列表可见性">
                            <label class="segmented__item"><input type="radio" name="connections_visibility" value="public" {{ prefs.connections_visibility == 'public' ? 'checked' : '' }}><span>所有人</span></label>
                            <label class="segmented__item"><input type="radio" name="connections_visibility" value="self" {{ prefs.connections_visibility == 'self' ? 'checked' : '' }}><span>仅自己</span></label>
                        </span>
                    </div>
                </div>
            </div>

            <div class="settings-group">
                <h2 class="settings-group__title">已读回执</h2>
                <div class="settings-card">
                    <div class="settings-row">
                        <span class="settings-row__text"><strong>已读回执</strong>需双方都开启才能看到「已读」</span>
                        <span class="segmented segmented--radio" role="radiogroup" aria-label="已读回执">
                            <label class="segmented__item"><input type="radio" name="read_receipt" value="1" {{ prefs.read_receipt ? 'checked' : '' }}><span>开启</span></label>
                            <label class="segmented__item"><input type="radio" name="read_receipt" value="0" {{ prefs.read_receipt ? '' : 'checked' }}><span>关闭</span></label>
                        </span>
                    </div>
                </div>
            </div>
        </form>

        <div class="settings-group">
            <h2 class="settings-group__title">拉黑名单</h2>
            <div class="settings-card">
                <div class="blocked-list">
                    {% for user in blockedUsers %}
                    {% embed 'components/user-row.twig' with { user: user, meta: '@' ~ user.username, avatar_size: 'sm', border: true, row_attrs: 'data-blocked-user="' ~ user.id ~ '"' } %}
                        {% block actions %}
                        <button class="text-btn text-btn--sm" type="button"
                                data-action="toggle-block" data-user-id="{{ user.id }}" data-from="settings">解除拉黑</button>
                        {% endblock %}
                    {% endembed %}
                    {% else %}
                    <p class="settings-hint">还没有拉黑任何人</p>
                    {% endfor %}
                </div>
            </div>
            <p class="settings-hint">拉黑后双方无法互相关注或私信，已有的关注关系会自动解除。</p>
        </div>
    </div>
</section>
{% endblock %}
