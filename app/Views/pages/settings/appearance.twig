{% extends 'layouts/app.twig' %}

{% block page_id %}settings{% endblock %}
{% block title %}外观 · {{ app.name }}{% endblock %}

{% set activeScheme = activeTheme ? (activeTheme.scheme|default('auto')) : 'auto' %}
{% set schemeLabels = { auto: '跟随系统', light: '浅色', dark: '深色' } %}

{% block content %}
<section class="settings-layout">
    {{ include('components/settings-nav.twig') }}

    <div class="settings-main" data-tabs-panel>
        <h1 class="page-title">外观</h1>
        <p class="page-subtitle">选择浅色或深色外观，或让 Mofukey 跟随系统设置。品牌强调色始终保持一致。</p>

        <div class="theme-center" data-theme-center
             data-default-theme="{{ defaultTheme|json_encode|e('html_attr') }}"
             data-active-theme="{{ activeTheme ? activeTheme|json_encode|e('html_attr') : '' }}">

            <div class="settings-group">
                <h2 class="settings-group__title">预览</h2>
                <div class="settings-card settings-card--pad">
                    <div class="theme-preview" data-theme-preview>
                        <div class="theme-preview__bar">
                            <span class="theme-preview__name">当前外观 · <span data-theme-preview-name>我的外观</span></span>
                        </div>
                        <div class="theme-preview__swatches" aria-hidden="true">
                            <span class="swatch" style="background: var(--color-accent)"></span>
                            <span class="swatch" style="background: var(--color-accent-container)"></span>
                            <span class="swatch" style="background: var(--color-surface-secondary)"></span>
                            <span class="swatch" style="background: var(--color-label-primary)"></span>
                            <span class="swatch" style="background: var(--color-label-secondary)"></span>
                        </div>
                        <div class="theme-preview__sample">
                            <span class="filled-btn filled-btn--sm" role="presentation">主要按钮</span>
                            <span class="outlined-btn outlined-btn--sm" role="presentation">次要按钮</span>
                            <span class="topic-chip">#话题标签</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="settings-group">
                <h2 class="settings-group__title">外观模式</h2>
                <div class="settings-card">
                    <div class="appearance-options" role="radiogroup" aria-label="外观模式">
                        <label class="appearance-option" data-mode="auto">
                            <input type="radio" name="appearance" value="auto" data-appearance-option
                                   {{ activeScheme == 'auto' ? 'checked' : '' }}>
                            <span class="appearance-option__preview" aria-hidden="true"></span>
                            <span class="appearance-option__label">
                                <span class="material-symbols-outlined" aria-hidden="true">brightness_auto</span>
                                跟随系统
                                <span class="material-symbols-outlined appearance-option__check" aria-hidden="true">check_circle</span>
                            </span>
                            <span class="appearance-option__hint">随设备自动切换浅色或深色</span>
                        </label>

                        <label class="appearance-option" data-mode="light">
                            <input type="radio" name="appearance" value="light" data-appearance-option
                                   {{ activeScheme == 'light' ? 'checked' : '' }}>
                            <span class="appearance-option__preview" aria-hidden="true"></span>
                            <span class="appearance-option__label">
                                <span class="material-symbols-outlined" aria-hidden="true">light_mode</span>
                                浅色
                                <span class="material-symbols-outlined appearance-option__check" aria-hidden="true">check_circle</span>
                            </span>
                            <span class="appearance-option__hint">明亮、清晰的浅色界面</span>
                        </label>

                        <label class="appearance-option" data-mode="dark">
                            <input type="radio" name="appearance" value="dark" data-appearance-option
                                   {{ activeScheme == 'dark' ? 'checked' : '' }}>
                            <span class="appearance-option__preview" aria-hidden="true"></span>
                            <span class="appearance-option__label">
                                <span class="material-symbols-outlined" aria-hidden="true">dark_mode</span>
                                深色
                                <span class="material-symbols-outlined appearance-option__check" aria-hidden="true">check_circle</span>
                            </span>
                            <span class="appearance-option__hint">适合弱光环境的深色界面</span>
                        </label>
                    </div>

                    <div class="settings-row">
                        <div class="settings-row__text">
                            <span class="settings-row__label">品牌强调色</span>
                            <span class="settings-row__desc">固定的 Mofukey 黄色，用于主操作与选中状态，不随外观改变</span>
                        </div>
                        <div class="settings-row__control">
                            <span class="brand-swatch" role="img" aria-label="品牌强调色 #FFCC38"></span>
                            <code>#FFCC38</code>
                        </div>
                    </div>
                </div>
            </div>

            <div class="settings-group">
                <h2 class="settings-group__title">保存</h2>
                <div class="settings-card">
                    <div class="settings-row">
                        <div class="settings-row__text">
                            <label class="settings-row__label" for="theme-name-input">外观名称</label>
                            <span class="settings-row__desc">用于在已保存的外观中识别</span>
                        </div>
                        <input class="field__input settings-row__input" id="theme-name-input" type="text"
                               maxlength="24" value="{{ activeTheme and activeTheme.name ? activeTheme.name : '我的外观' }}"
                               data-theme-name>
                    </div>
                    <div class="theme-actions settings-row">
                        <button class="filled-btn" type="button" data-action="save-theme">保存并应用</button>
                        <button class="text-btn" type="button" data-action="reset-theme">恢复跟随系统</button>
                    </div>
                </div>

                <div class="theme-saved">
                    <ul class="theme-saved__list" data-theme-saved-list>
                        {% for t in userThemes %}
                        <li class="theme-saved__item{{ t.is_active ? ' is-active' : '' }}" data-theme-id="{{ t.id }}">
                            <span class="theme-saved__name">
                                {{ t.name }}
                                <span class="settings-row__desc">{{ schemeLabels[t.scheme]|default('跟随系统') }}</span>
                            </span>
                            <span class="theme-saved__color" aria-hidden="true"></span>
                            {% if not t.is_active %}
                            <button class="text-btn text-btn--sm" type="button" data-action="activate-theme" data-theme-id="{{ t.id }}">应用</button>
                            {% else %}
                            <span class="meta-chip meta-chip--accent">使用中</span>
                            {% endif %}
                            <button class="text-btn text-btn--sm text-btn--danger" type="button" data-action="delete-theme" data-theme-id="{{ t.id }}">删除</button>
                        </li>
                        {% else %}
                        <li class="theme-saved__empty">还没有保存的外观</li>
                        {% endfor %}
                    </ul>
                </div>
            </div>

            <div class="settings-group">
                <h2 class="settings-group__title" data-i18n="settings.language_title">语言</h2>
                <div class="settings-card">
                    <div class="settings-row">
                        <div class="settings-row__text">
                            <span class="settings-row__label" data-i18n="settings.language">界面语言</span>
                            <span class="settings-row__desc" data-i18n="settings.language_desc">选择应用界面显示的语言</span>
                        </div>
                        <select data-lang-select aria-label="界面语言">
                            <option value="zh-CN" selected>简体中文</option>
                            <option value="en">English</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
