{% extends 'layouts/app.twig' %}

{% block page_id %}tag{% endblock %}
{% block title %}{{ tag.name }} · 标签 · {{ app.name }}{% endblock %}

{% block content %}
<section class="topic-page">
    <header class="topic-head">
        <h1 class="topic-head__title">{{ tag.name }}</h1>
        <p class="topic-head__meta">共 {{ feed.total }} 条公开动态</p>
        {% if tag.description is not empty %}<p class="topic-head__desc">{{ tag.description }}</p>{% endif %}
    </header>

    <div class="feed-list" data-list="tag-posts">
        {% for post in feedItems %}
            {{ include('components/post-card.twig', { post: post }) }}
        {% else %}
        <div class="empty-state">
            <span class="material-symbols-outlined empty-state__icon" aria-hidden="true">sell</span>
            <p class="empty-state__title">这个标签下还没有公开动态</p>
            <p class="empty-state__text">发布动态时选择该标签即可参与</p>
            {% if currentUser %}<a class="filled-btn" href="/compose">发布动态</a>{% endif %}
        </div>
        {% endfor %}
    </div>

    {{ include('components/load-more.twig', { pagination: feed, base: '/tags/' ~ tag.slug|url_encode ~ '?', target: 'tag-posts' }) }}
</section>
{% endblock %}
