{% extends 'layouts/app.twig' %}

{% block page_id %}search{% endblock %}
{% block title %}{{ q is not empty ? q ~ ' 的搜索结果' : '全站搜索' }} · {{ app.name }}{% endblock %}

{% block content %}
<section class="search-page">
    <form class="search-hero" method="get" action="/search" role="search">
        <span class="material-symbols-outlined search-hero__icon" aria-hidden="true">search</span>
        <input class="search-hero__input" type="search" name="q" value="{{ q }}" maxlength="50"
               placeholder="搜索动态、同学、话题、表白墙…" aria-label="搜索关键词" autocomplete="off">
        <button class="filled-btn filled-btn--sm" type="submit">搜索</button>
        <div class="search-suggest" data-search-suggest hidden role="listbox" aria-label="搜索建议"></div>
    </form>

    {% if q is empty %}
    <div class="search-history" data-search-history-wrap hidden>
        <div class="search-history__head">
            <h2 class="search-history__title">搜索历史</h2>
            <button class="text-btn text-btn--sm" type="button" data-action="clear-search-history">清空</button>
        </div>
        <div class="search-history__chips" data-search-history></div>
    </div>

    {% if hotTopics|length > 0 %}
    <div class="card side-card">
        <h2 class="side-card__title">热门话题</h2>
        <div class="topic-cloud">
            {% for topic in hotTopics %}
            <a class="topic-chip" href="/topics/{{ topic.slug|url_encode }}">#{{ topic.name }}</a>
            {% endfor %}
        </div>
    </div>
    {% endif %}

    <div class="empty-state">
        <span class="material-symbols-outlined empty-state__icon" aria-hidden="true">manage_search</span>
        <p class="empty-state__title">输入关键词开始搜索</p>
        <p class="empty-state__text">可以搜索动态内容、用户、话题，以及表白墙与树洞</p>
    </div>
    {% else %}

    {% set tabs = { all: '全部', posts: '动态', users: '用户', topics: '话题', confessions: '表白墙' } %}
    <nav class="feed-tabs search-tabs" aria-label="搜索类型">
        {% for key, label in tabs %}
        <a class="feed-tab{{ type == key ? ' is-active' : '' }}" href="/search?q={{ q|url_encode }}&type={{ key }}">{{ label }}</a>
        {% endfor %}
    </nav>

    {% if mode == 'all' %}
        {% set sectionsMeta = {
            posts: '动态',
            users: '用户',
            topics: '话题',
            confessions: '表白墙 / 树洞'
        } %}

        {% if sections.posts.total + sections.users.total + sections.topics.total + sections.confessions.total == 0 %}
        <div class="empty-state">
            <span class="material-symbols-outlined empty-state__icon" aria-hidden="true">search_off</span>
            <p class="empty-state__title">没有找到与「{{ q }}」相关的内容</p>
            <p class="empty-state__text">换个关键词试试，或者浏览热门话题</p>
        </div>
        {% else %}
            {% for key, section in sections %}
                {% if section.total > 0 %}
                <div class="search-section">
                    <div class="search-section__head">
                        <h2 class="search-section__title">{{ sectionsMeta[key] }}<span class="search-section__count">共 {{ section.total }} 条</span></h2>
                        <a class="search-section__more" href="/search?q={{ q|url_encode }}&type={{ key }}">查看全部</a>
                    </div>

                    {% if key == 'posts' %}
                    <div class="feed-list">
                        {% for post in section.items %}
                            {{ include('components/post-card.twig', { post: post }) }}
                        {% endfor %}
                    </div>
                    {% elseif key == 'users' %}
                    <div class="user-list">
                        {% for user in section.items %}
                            {{ include('components/user-card.twig', { user: user }) }}
                        {% endfor %}
                    </div>
                    {% elseif key == 'topics' %}
                    <div class="topic-cloud">
                        {% for topic in section.items %}
                        <a class="topic-chip" href="/topics/{{ topic.slug|url_encode }}">#{{ topic.name }} <span class="topic-chip__count">{{ topic.use_count }}</span></a>
                        {% endfor %}
                    </div>
                    {% else %}
                    <div class="board__list">
                        {% for item in section.items %}
                            {{ include('components/confession-card.twig', { item: item }) }}
                        {% endfor %}
                    </div>
                    {% endif %}
                </div>
                {% endif %}
            {% endfor %}
        {% endif %}

    {% else %}

        {% if result.total == 0 %}
        <div class="empty-state">
            <span class="material-symbols-outlined empty-state__icon" aria-hidden="true">search_off</span>
            <p class="empty-state__title">没有找到与「{{ q }}」相关的内容</p>
            <p class="empty-state__text">换个关键词试试，或者浏览热门话题</p>
        </div>
        {% else %}
        <div class="search-section">
            {% if type == 'posts' %}
            <div class="feed-list" data-list="search-results">
                {% for post in result.items %}
                    {{ include('components/post-card.twig', { post: post }) }}
                {% endfor %}
            </div>
            {% elseif type == 'users' %}
            <div class="user-list" data-list="search-results">
                {% for user in result.items %}
                    {{ include('components/user-card.twig', { user: user }) }}
                {% endfor %}
            </div>
            {% elseif type == 'topics' %}
            <div class="topic-cloud" data-list="search-results">
                {% for topic in result.items %}
                <a class="topic-chip" href="/topics/{{ topic.slug|url_encode }}">#{{ topic.name }} <span class="topic-chip__count">{{ topic.use_count }}</span></a>
                {% endfor %}
            </div>
            {% else %}
            <div class="board__list" data-list="search-results">
                {% for item in result.items %}
                    {{ include('components/confession-card.twig', { item: item }) }}
                {% endfor %}
            </div>
            {% endif %}
        </div>

        {{ include('components/load-more.twig', { pagination: result, base: '/search?q=' ~ q|url_encode ~ '&type=' ~ type ~ '&', target: 'search-results' }) }}
        {% endif %}

    {% endif %}
    {% endif %}
</section>
{% endblock %}
