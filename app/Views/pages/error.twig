{% extends 'layouts/app.twig' %}

{% block page_id %}error{% endblock %}
{% block title %}{{ status }} · {{ app.name }}{% endblock %}

{% block content %}
<div class="error-page">
    <p class="error-page__code">{{ status }}</p>
    <h1 class="error-page__title">{{ message }}</h1>
    {% if detail %}<pre class="error-page__detail">{{ detail }}</pre>{% endif %}
    <div class="error-page__actions">
        {% if status == 401 or (status == 403 and not currentUser) %}
        <a class="filled-btn" href="/login?redirect={{ currentPath|url_encode }}">登录后继续</a>
        <a class="outlined-btn" href="/">返回首页</a>
        {% elseif status == 403 and currentUser and currentUser.can_admin %}
        <a class="filled-btn" href="/admin">返回后台</a>
        <a class="outlined-btn" href="/">返回首页</a>
        {% else %}
        <a class="filled-btn" href="/">返回首页</a>
        {% endif %}
    </div>

    {% if status == 401 or status == 403 %}
    <p class="hint">
        {% if status == 401 %}该页面需要登录后访问。{% else %}当前账号没有访问该页面的权限；如果你认为这是误判，请联系管理员。{% endif %}
    </p>
    {% endif %}
</div>
{% endblock %}
