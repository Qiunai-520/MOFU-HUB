{% extends 'layouts/admin.twig' %}

{% block page_id %}admin{% endblock %}
{% block title %}标签管理 · {{ app.name }}{% endblock %}

{% macro tagFields(item) %}
    <div class="admin-form__grid">
        <label class="field">
            <span class="field__label">名称</span>
            <input class="field__input" type="text" name="name" maxlength="32" required value="{{ item.name|default('') }}">
        </label>
        <label class="field">
            <span class="field__label">标识 slug（可选，留空自动生成）</span>
            <input class="field__input" type="text" name="slug" value="{{ item.slug|default('') }}">
        </label>
        <label class="field">
            <span class="field__label">颜色（可空，如 #2f6f4f）</span>
            <input class="field__input" type="text" name="color" maxlength="16" value="{{ item.color|default('') }}">
        </label>
    </div>
    <label class="field">
        <span class="field__label">描述（可选）</span>
        <input class="field__input" type="text" name="description" maxlength="255" value="{{ item.description|default('') }}">
    </label>
    <div class="admin-form__grid">
        <label class="field">
            <span class="field__label">排序（小在前）</span>
            <input class="field__input" type="number" name="sort" value="{{ item.sort|default(0) }}">
        </label>
        <label class="field">
            <span class="field__label">启用</span>
            <select class="field__input" name="active">
                <option value="1" {{ item is not defined or item.active ? 'selected' : '' }}>是</option>
                <option value="0" {{ item is defined and not item.active ? 'selected' : '' }}>否</option>
            </select>
        </label>
    </div>
{% endmacro %}

{% block admin_content %}
<div class="admin-head">
    <h1 class="page-title">标签管理</h1>
    <p class="admin-head__hint">标签由后台维护；作者达到 Lv.3 后可为自己投稿的帖子选择标签。前台浏览入口：<code>/tags</code>。</p>
</div>

{% if ok %}<div class="form-success" role="status">已保存</div>{% endif %}
{% if error is not empty %}<div class="form-alert" role="alert">{{ error }}</div>{% endif %}

<section class="admin-card">
    <h2 class="admin-card__title">新建标签</h2>
    <form class="admin-form" method="post" action="/admin/tags">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        {{ _self.tagFields({}) }}
        <div class="admin-form__actions">
            <button class="filled-btn filled-btn--sm" type="submit">创建标签</button>
        </div>
    </form>
</section>

<section class="admin-card">
    <h2 class="admin-card__title">标签列表（{{ tags|length }}）</h2>
    {% for item in tags %}
    <details class="admin-row">
        <summary class="admin-row__summary">
            <span class="tag-chip"{% if item.color is not empty %} style="--tag-color: {{ item.color }}"{% endif %}>{{ item.name }}</span>
            <span class="admin-row__title">{{ item.slug }}</span>
            {% if not item.active %}<span class="tag">已停用</span>{% endif %}
            <span class="admin-row__meta">排序 {{ item.sort }}</span>
        </summary>
        <form class="admin-form" method="post" action="/admin/tags/{{ item.id }}/save">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            {{ _self.tagFields(item) }}
            <div class="admin-form__actions">
                <button class="filled-btn filled-btn--sm" type="submit">保存</button>
            </div>
        </form>
        <form class="inline-form" method="post" action="/admin/tags/{{ item.id }}/delete"
              data-confirm="删除标签会同时移除所有帖子上的该标签，确定吗？">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            <button class="text-btn text-btn--danger text-btn--sm" type="submit">删除</button>
        </form>
    </details>
    {% else %}
    <p class="admin-empty">还没有标签</p>
    {% endfor %}
</section>
{% endblock %}
