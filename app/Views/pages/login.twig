{% extends 'layouts/app.twig' %}

{% block page_id %}login{% endblock %}
{% block title %}登录 · {{ app.name }}{% endblock %}

{% block content %}
<div class="auth-layout">
    <section class="auth-card">
        <h1 class="auth-card__title">欢迎回来</h1>
        <p class="auth-card__subtitle">登录 {{ app.name }}，继续你的校园之旅</p>

        {% if notice is defined and notice %}
        <div class="form-success" role="status">{{ notice }}</div>
        {% endif %}

        {% if errors.login is defined %}
        <div class="form-alert" role="alert">{{ errors.login }}</div>
        {% endif %}

        {% if canAppeal is defined and canAppeal %}
        <p class="auth-card__hint">若认为处理有误，可<a href="/appeal?username={{ values.login|url_encode }}">提交申诉</a></p>
        {% endif %}

        <form method="post" action="/login" class="auth-form" novalidate>
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            <input type="hidden" name="redirect" value="{{ redirect }}">

            {% if redirect != '/' %}
            <p class="auth-card__hint">登录后将继续前往你刚才访问的页面</p>
            {% endif %}

            <label class="field" for="login-input">
                <span class="field__label">用户名或邮箱</span>
                <input class="field__input" id="login-input" type="text" name="login" value="{{ values.login }}" autocomplete="username" required autofocus>
            </label>

            <label class="field" for="password-input">
                <span class="field__label">密码</span>
                <input class="field__input" id="password-input" type="password" name="password" autocomplete="current-password" required>
            </label>

            <button class="filled-btn filled-btn--block" type="submit">登录</button>
        </form>

        <p class="auth-card__hint">还没有设置密码？<a href="/password/reset">通过邮箱设置 / 重置密码</a></p>

        <p class="auth-card__foot">还没有账号？<a href="/register">立即注册</a></p>
    </section>
</div>
{% endblock %}
