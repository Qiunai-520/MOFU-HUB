# MOFU社区 — Apache 重写规则
# 适用于：站点根目录指向 public/ 的独立服务器与虚拟主机。
#
# 若你的主机只能把域名根目录指向项目目录（无法指向 public/），
# 请把本文件内容与 public/index.php 按部署说明另行处理。

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 真实存在的文件与目录直接返回（静态资源）
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 其余全部交给单入口
    RewriteRule ^ index.php [L]
</IfModule>

# 基础安全响应头
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    # 内容安全策略：已从观察模式转为强制。策略放宽到 allow inline 与 http(s) 外链资源，
    # 保留真正有效的部分（default-src self、object-src none、base-uri/form-action 限制）。
    Header set Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: http: https:; media-src 'self' blob: http: https:; style-src 'self' 'unsafe-inline' http: https:; script-src 'self' 'unsafe-inline' http: https:; font-src 'self' data: http: https:; connect-src 'self' http: https:; frame-src http: https:; object-src 'none'; base-uri 'self'; form-action 'self'"
</IfModule>

# Brotli 优先，未启用时回退到 gzip。字体本身已压缩，不重复压缩。
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

# PWA：Service Worker 不缓存（保证版本更新即时生效），补充 manifest MIME 类型
<Files "sw.js">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-cache"
    </IfModule>
</Files>
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
    # 部分虚拟主机未给 .js/.css 正确 MIME，模块脚本会被浏览器拒绝执行
    AddType text/javascript .js
    AddType text/css .css
    # 自托管字体（public/fonts）
    AddType font/ttf .ttf
    AddType font/woff2 .woff2
    # 语言包与表情包是 .json，显式声明 MIME，避免部分主机缺失映射
    AddType application/json .json
</IfModule>

# 隐藏敏感文件类型
# 注意：不能整类拒绝 .json —— 前端会读取 /i18n/*.json（语言包）与 /vendor/emoji-apple.json（表情包），
# 整类拒绝会导致 Apache 部署下这两者 403。这里只拒绝确属配置/构建元数据的具体文件。
<FilesMatch "\.(env|sql|log|md|lock)$">
    Require all denied
</FilesMatch>
<FilesMatch "^(composer\.json|composer\.lock|package\.json|package-lock\.json|manifest\.json)$">
    Require all denied
</FilesMatch>

# 静态资源缓存（构建产物带内容哈希，可长期缓存）
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
</IfModule>
